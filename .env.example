# App
APP_NAME=itsectest
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database
DB_HOST=db
DB_PORT=5432
DB_NAME=itsectest_library
DB_USERNAME=itsectest_user
DB_PASSWORD=itsectest_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-key
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_REFRESH_TOKEN_TTL_DAYS=7

# Mail (untuk OTP, dll) - pakai Mailhog di docker-compose
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME="ITSEC Test"

# Spring Boot
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false